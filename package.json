{
  "name": "openvibe-publishing",
  "version": "1.7.1",
  "description": "Shared publishing packages for the OpenVibe publication products, on PostgreSQL through openvibe-sdk/db: revisions, scheduling, taxonomy, citations, media attachments, discussion references, the SEO indexability gate, authorship, index hooks, SSR helpers, the ingest chassis (Sources client, change cursor, signed event consumer, normalisers, PSL) and the publication glue. Packages, not an authority.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./revisions": "./lib/revisions.js",
    "./schedule": "./lib/schedule.js",
    "./taxonomy": "./lib/taxonomy.js",
    "./citations": "./lib/citations.js",
    "./media": "./lib/media.js",
    "./discussion": "./lib/discussion.js",
    "./seo": "./lib/seo.js",
    "./authorship": "./lib/authorship.js",
    "./index-hooks": "./lib/index-hooks.js",
    "./ssr": "./lib/ssr.js",
    "./blocks": "./lib/blocks.js",
    "./blocks.css": "./blocks.css",
    "./ai": "./lib/ai.js",
    "./ingest": "./lib/ingest.js",
    "./publication": "./lib/publication.js",
    "./layout": "./lib/layout.js",
    "./search-feed": "./lib/search-feed.js",
    "./search-relay": "./lib/search-relay.js"
  },
  "files": [
    "index.js",
    "lib/",
    "blocks.css",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenVibers/OpenVibe.Publishing.git"
  },
  "homepage": "https://github.com/OpenVibers/OpenVibe.Publishing#readme",
  "license": "MIT",
  "peerDependencies": {
    "openvibe-sdk": ">=0.15.0",
    "openvibe-shared": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "openvibe-shared": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "openvibe-contracts": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.contracts/archive/v0.443.0.tar.gz",
    "openvibe-sdk": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.sdk/archive/v0.177.0.tar.gz",
    "openvibe-shared": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.shared/archive/v4.317.0.tar.gz",
    "pg": "^8.23.0"
  }
}
